    {"pattern": "docs/CLI_CONTRACT.md", "mode": "merge-sections"},
    {"pattern": "docs/RELEASE.md", "mode": "merge-sections"},

    {"pattern": "docs/design_standards/**", "mode": "managed"},
    {"pattern": ".agents/skills/desktop-implement-change/scripts/check_file_line_limits.py", "mode": "managed"},
    {"pattern": ".agents/skills/desktop-implement-change/scripts/test_check_file_line_limits.py", "mode": "managed"},
    {"pattern": ".agents/skills/desktop-implement-change/scripts/check_core_first.py", "mode": "managed"},
    {"pattern": ".agents/skills/desktop-implement-change/scripts/test_check_core_first.py", "mode": "managed"},
    {"pattern": ".agents/skills/desktop-implement-change/scripts/check_rust_chinese_comments.py", "mode": "managed"},
    {"pattern": ".agents/skills/desktop-implement-change/scripts/test_check_rust_chinese_comments.py", "mode": "managed"},
    {"pattern": ".agents/skills/desktop-upgrade-harness/**", "mode": "managed-self"},
    {"pattern": ".agents/skills/desktop-add-cli-adapter/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-tui-adapter/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-mcp-adapter/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-gui-adapter/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-gui-system-locale/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-gui-updater/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-gui-window-state/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-gui-dialog/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-gui-system-tray/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-gui-single-instance/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-gui-deep-link/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-gui-global-shortcut/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-gui-system-notifications/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-add-gui-autostart/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-prepare-gui-app-identity/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-prepare-gui-support-surfaces/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-test-gui-release-performance/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-prepare-cross-platform-release/**", "mode": "conditional"},
    {"pattern": ".agents/skills/desktop-build-tauri-release/**", "mode": "conditional"},
    {"pattern": ".agents/skills/**", "mode": "managed"}
