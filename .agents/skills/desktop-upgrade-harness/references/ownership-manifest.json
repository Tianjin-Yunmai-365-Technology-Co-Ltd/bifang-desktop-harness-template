{
  "schema_version": 1,
  "default_mode": "protected",
  "rules": [
    {"pattern": "Version.md", "mode": "tombstone"},
    {"pattern": ".agents/skills/desktop-instantiate-project/**", "mode": "tombstone"},
    {"pattern": ".agents/skills/desktop-initialize-rust-project/**", "mode": "tombstone"},
    {"pattern": ".agents/skills/desktop-test-gui-initialization-e2e/**", "mode": "tombstone"},
    {"pattern": "scripts/validate_harness.py", "mode": "tombstone"},
    {"pattern": "scripts/test_agile_workflow.py", "mode": "tombstone"},
    {"pattern": "scripts/test_harness_scope_and_initialization_boundaries.py", "mode": "tombstone"},
    {"pattern": "scripts/test_validate_harness.py", "mode": "tombstone"},
    {"pattern": "scripts/harness_validation/**", "mode": "tombstone"},
    {"pattern": "docs/HARNESS_ENGINEERING.md", "mode": "tombstone"},
    {"pattern": "docs/harness_engineering/**", "mode": "tombstone"},

    {"pattern": "docs/AGENT_POLICY.md", "mode": "protected"},
    {"pattern": "docs/GUI_SUPPORT_SURFACES.md", "mode": "protected"},
    {"pattern": "docs/product_spec/**", "mode": "protected"},
    {"pattern": "docs/project_status/**", "mode": "protected"},
    {"pattern": "docs/work_plan/**", "mode": "protected"},
    {"pattern": "docs/adr/**", "mode": "protected"},
    {"pattern": "docs/changelog/**", "mode": "protected"},
