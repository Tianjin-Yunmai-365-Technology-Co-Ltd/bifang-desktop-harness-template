    {"pattern": "docs/TECH_DEBT.md", "mode": "protected"},
    {"pattern": ".harness/version-state.json", "mode": "protected"},
    {"pattern": "release-notes.json", "mode": "protected"},
    {"pattern": "LICENSE.zh-CN.md", "mode": "protected"},
    {"pattern": "LICENSE.en.md", "mode": "protected"},
    {"pattern": "Cargo.toml", "mode": "protected"},
    {"pattern": "Cargo.lock", "mode": "protected"},
    {"pattern": ".gitignore", "mode": "protected"},

    {"pattern": "AGENTS.md", "mode": "merge-sections"},
    {"pattern": "README.md", "mode": "merge-sections"},
    {"pattern": "docs/ENGINEERING_RULES.md", "mode": "merge-sections"},
