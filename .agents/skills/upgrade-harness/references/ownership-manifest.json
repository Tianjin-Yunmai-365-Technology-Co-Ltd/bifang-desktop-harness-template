{
  "schema_version": 1,
  "default_mode": "protected",
  "rules": [
    {"pattern": "Version.md", "mode": "tombstone"},
    {"pattern": ".agents/skills/instantiate-project/**", "mode": "tombstone"},
    {"pattern": ".agents/skills/initialize-rust-project/**", "mode": "tombstone"},
    {"pattern": "scripts/validate_harness.py", "mode": "tombstone"},
    {"pattern": "scripts/test_agile_workflow.py", "mode": "tombstone"},
    {"pattern": "scripts/test_validate_harness.py", "mode": "tombstone"},
    {"pattern": "scripts/harness_validation/**", "mode": "tombstone"},
    {"pattern": "docs/HARNESS_ENGINEERING.md", "mode": "tombstone"},

    {"pattern": "docs/AGENT_POLICY.md", "mode": "protected"},
    {"pattern": "docs/product_spec/**", "mode": "protected"},
    {"pattern": "docs/project_status/**", "mode": "protected"},
    {"pattern": "docs/work_plan/**", "mode": "protected"},
    {"pattern": "docs/adr/**", "mode": "protected"},
    {"pattern": "docs/changelog/**", "mode": "protected"},
    {"pattern": "docs/VERIFICATION.md", "mode": "protected"},
    {"pattern": "docs/TECH_DEBT.md", "mode": "protected"},
    {"pattern": "LICENSE.zh-CN.md", "mode": "protected"},
    {"pattern": "LICENSE.en.md", "mode": "protected"},
    {"pattern": "Cargo.toml", "mode": "protected"},
    {"pattern": "Cargo.lock", "mode": "protected"},
    {"pattern": ".gitignore", "mode": "protected"},

    {"pattern": "AGENTS.md", "mode": "merge-sections"},
    {"pattern": "README.md", "mode": "merge-sections"},
    {"pattern": "docs/ENGINEERING_RULES.md", "mode": "merge-sections"},
    {"pattern": "docs/RUST_CLI_TEMPLATE.md", "mode": "merge-sections"},
    {"pattern": "docs/CLI_CONTRACT.md", "mode": "merge-sections"},
    {"pattern": "docs/RELEASE.md", "mode": "merge-sections"},

    {"pattern": ".agents/skills/upgrade-harness/**", "mode": "managed-self"},
    {"pattern": ".agents/skills/add-cli-adapter/**", "mode": "conditional"},
    {"pattern": ".agents/skills/add-tui-adapter/**", "mode": "conditional"},
    {"pattern": ".agents/skills/add-mcp-adapter/**", "mode": "conditional"},
    {"pattern": ".agents/skills/add-gui-adapter/**", "mode": "conditional"},
    {"pattern": ".agents/skills/prepare-gui-app-identity/**", "mode": "conditional"},
    {"pattern": ".agents/skills/prepare-cross-platform-release/**", "mode": "conditional"},
    {"pattern": ".agents/skills/build-tauri-release/**", "mode": "conditional"},
    {"pattern": ".agents/skills/**", "mode": "managed"}
  ]
}
